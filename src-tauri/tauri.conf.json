{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitHub Monitor",
  "version": "0.2.4",
  "identifier": "com.adamhiggins.github-monitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GitHub Monitor",
        "width": 1440,
        "height": 940,
        "minWidth": 1040,
        "minHeight": 680,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://avatars.githubusercontent.com https://*.githubusercontent.com https://open-vsx.org; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "publisher": "Adam Higgins",
    "homepage": "https://github.com/adampeterhiggins/github-monitor",
    "category": "public.app-category.utilities",
    "copyright": "Copyright © 2026 Adam Higgins",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0NUY2M0UzRDUzODI0MkMKUldRc0pEalY0Mk5mNUEvNVZBM2sxNGQ2WU9seFAxb0cyYkY0b0tuZ0lkNW11eGJTY0RWaUVqa3gK",
      "endpoints": [
        "https://raw.githubusercontent.com/adampeterhiggins/github-monitor/releases/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
