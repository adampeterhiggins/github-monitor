{
  "name": "github-monitor",
  "private": true,
  "version": "0.2.1",
  "description": "Native macOS app for GitHub Insights analytics across a whole organisation",
  "author": "Adam Higgins",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adampeterhiggins/github-monitor.git"
  },
  "homepage": "https://github.com/adampeterhiggins/github-monitor",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "verify:aggregation": "node scripts/verify-aggregation.mjs",
    "test:queries": "node scripts/test-queries.mjs",
    "test:themes": "node scripts/test-themes.mjs",
    "check": "npm run typecheck && npm run test:queries && npm run test:themes && npm run check:workflows",
    "release:prepare": "node scripts/set-version.mjs",
    "release:manifest": "node scripts/build-update-manifest.mjs",
    "check:workflows": "node scripts/lint-workflows.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "date-fns": "^4.4.0",
    "jsonc-parser": "^3.3.1",
    "jszip": "^3.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/culori": "^4.0.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "yaml": "^2.9.0"
  }
}
